{
  "productName": "PromptX",
  "version": "1.5.0",
  "identifier": "com.promptx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:51730",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PromptX",
        "width": 600,
        "height": 400,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc.localhost http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMkE3NzUwMjhFQkZBNTEKUldSUit1c29VSGNxRXRtU2lmOEhPZ1BxaHlhYkVPSkNEaVRaYXZsaWFQN3dyckI4NisrSkdwSTYK",
      "endpoints": [
        "https://github.com/kanosa0101/PromptX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "PromptX",
    "shortDescription": "Lightweight AI Prompt Manager",
    "longDescription": "PromptX is a lightweight desktop prompt management tool for AI developers and researchers."
  }
}